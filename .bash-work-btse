# node 記憶體相關
export NODE_OPTIONS=--max_old_space_size=8192

alias prettierExecPermission='chmod +x ./node_modules/prettier/bin/prettier.cjs'

# 清除 node_modules 裡的 .vite folder
alias rrrvvv='rm -rf ./node_modules/.vite;echo "刪除 node_modules 裡的 .vite 成功"'

# 快速使用查找檔案相關連結的腳本: btse
alias yyyaffected='yarn affected-paths --brand btse --trace --target'

# 移動相關
alias fe='cd ~/btse/frontend' # go to frontend project root
alias ff='cd ~/btse/ff-worktree' # go to frontend worktree
alias ww='cd ~/btse/ww' # go to frontend worktree
alias ee='cd ~/btse/mjml_email_template' # go to email project root
alias fd='cd ~/btse/freshdesk-btse-theme' # go to freshdesk-btse-them
alias ddnnss='~/flyc/sublime-fetch/analyze_domain.sh' # dns 小工具 by AI
alias bstatic='cd ~/btse/btse-static-resource' # go to btse-static-resource
alias deeplink='cd ~/btse/app' # go to app deeplink folder
alias deeplink-btzo='cd ~/btse/app/btzo' # go to app deeplink folder - btzo
alias deeplink-btse='cd ~/btse/app/btse' # go to app deeplink folder - btse
alias deeplink-bullstreetex='cd ~/btse/app/bullstreetex' # go to app deeplink folder - bullstreetex
alias atat='cd ~/btse/aws-tools' # go to aws-tools
alias o='open .' # open current path
alias eeff=_eeff # 透過 npx 執行 eslint 自動修復
alias diff_copy='git diff origin/develop...HEAD | pbcopy' # 透過 npx 執行 eslint 自動修復

function _eeff () {
  npx eslint --fix $(git diff --name-only) $(git diff --staged --name-only)
}

# 更新 brew 和 omz
alias uuupdate_brew_and_omz='brew update; brew upgrade; brew cleanup; omz update; rb'

