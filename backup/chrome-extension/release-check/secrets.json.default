{
  "//": "機密設定。複製本檔為 secrets.json 並填入實際值。secrets.json 已被 .gitignore，切勿提交。",

  "jira": {
    "//": "Jira Cloud (btse.atlassian.net) 用 email + API token 做 Basic Auth，不是 PAT。",
    "//apiToken": "到 https://id.atlassian.com/manage-profile/security/api-tokens 產生 API token",
    "email": "__PUT_YOUR_ATLASSIAN_EMAIL_HERE__",
    "apiToken": "__PUT_YOUR_JIRA_API_TOKEN_HERE__"
  },

  "gitlab": {
    "//": "GitLab Personal Access Token，scope 需勾選 read_api（查 Merge Request 用）。",
    "token": "__PUT_YOUR_GITLAB_READ_API_TOKEN_HERE__"
  }
}
