{
  "//": "非機密設定。複製本檔為 release-check.config.json 後填寫。",

  "jira": {
    "baseUrl": "https://btse.atlassian.net",
    "//projects": "要撈 ticket 的 Jira project key 清單，用來組 JQL 範圍",
    "projects": ["PLAT"]
  },

  "gitlab": {
    "//baseUrl": "你們 GitLab 的網址，例如 https://gitlab.example.com",
    "baseUrl": "https://gitlab.example.com"
  },

  "//requiredRepos": "這套工具必須檢查的 repo 清單（必填）。可寫成 namespace/project 或完整 git URL，比對時會正規化。",
  "requiredRepos": ["group/repo-a", "group/sub/repo-b"],

  "//localRepoPaths": "你本機實際 clone 好的 repo 路徑清單。工具會在每個路徑跑 git remote，確認上面的 requiredRepos 是否都在本機。",
  "localRepoPaths": ["/Users/you/work/repo-a", "/Users/you/work/repo-b"],

  "//stagingBranches": "『已上 staging』的條件：branch 需 merge 進這裡「全部」分支（測試環境）。",
  "stagingBranches": ["dev", "staging"],

  "//doneBranches": "『已完成合併』的條件：已上 staging 後，再 merge 進這裡「全部」分支（如 develop，代表需求真正結束）。",
  "doneBranches": ["develop"],

  "//defaultAssignee": "撈 ticket 時 assignee 的預設值（名字或 email），執行時可互動覆寫或清空。留 null 代表預設不限 assignee。",
  "defaultAssignee": null,

  "//doneStatuses": "Jira 狀態命中 → 視為『已完成』的必要條件（還會用 git 驗證 develop 是否包含此 branch）。陣列或依 issue type 的物件（default 為 fallback，type key 忽略大小寫）。",
  "doneStatuses": {
    "default": ["Verified", "Testnet"],
    "Job Order": ["Code Review"]
  },

  "//sentToTestStatuses": "Jira 狀態命中 → 沒 branch 時視為『已送測』（不用改 code / branch 已刪的情境）。格式同上。",
  "sentToTestStatuses": {
    "default": ["Verified", "Testnet", "QA"],
    "Job Order": ["Code Review"]
  },

  "//urgentWithinDays": "staging deadline 在今天起幾天內算「緊迫（黃）」。",
  "urgentWithinDays": 3,

  "//statusEmoji": "opened MR 旁標注該單 QA 狀態的 emoji。key=Jira 狀態，value=emoji；保留 key __default__ 對應未列出的狀態。",
  "statusEmoji": {
    "QA": "👀",
    "Verified": "✅",
    "__default__": "❔"
  },

  "//deploy": "選填。『部署 brand 到 staging』用。repo：內含 .gitlab-ci.staging-whitelabel-matrix.config.yml 的 GitLab repo（namespace/project 或完整 URL）。固定讀該 repo staging 分支的 matrix 檔列出可部署 brand；觸發時 branch=staging、variable RECIPE=選到的 WHITELABEL_NAME，一 brand 一條 pipeline。",
  "deploy": {
    "repo": "group/your-deploy-repo"
  },

  "//i18nRedeploy": "選填。Pipeline →『重新部署 I18n』。立即 Play 一個現有排程（不帶參數）。repo 可為 namespace/project 或完整 URL。指定排程用 scheduleName 或 scheduleId 其一：scheduleName 以名稱『完全匹配』尋找、且必須唯一（0 或 >1 個都終止），只需讀取權限，適合沒有排程編輯權；scheduleId 從排程頁 URL .../pipeline_schedules/<id>/edit 取得。兩者都給時以 scheduleName 為準。",
  "i18nRedeploy": {
    "repo": "https://gitlab.com/your-group/your-i18n-repo",
    "scheduleName": "Redeploy I18n",
    "scheduleId": 123456
  },

  "//fixVersionMatch": "依今天日期挑選 fix version 的規則。互動模式分兩題問（Q1 往後天數或日期區間、Q2 往前幾天）；非互動 --days 未給時，窗為 [今天−daysBehind, 今天+daysAhead]。執行時可互動覆寫。",
  "//fixVersionMatch.daysBehind": "往前涵蓋幾天的預設值：互動 Q2『往前幾天』的預設值，以及非互動 --days 未給時的往前天數。設 >0 會納入近幾天已發的版本（多半已進 Done，屬預期）。",
  "//fixVersionMatch.dateTokenRegex": "選填。版本名稱抽日期的自訂 regex，第 1 個 capture group 應為 8 碼 YYYYMMDD；留 null 則預設掃描名稱中的 8 碼數字。",
  "fixVersionMatch": {
    "daysAhead": 30,
    "daysBehind": 0,
    "dateTokenRegex": null
  }
}
