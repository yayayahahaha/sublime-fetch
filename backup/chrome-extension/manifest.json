{
  "manifest_version": 3,
  "name": "My Awesome",
  "version": "1.0",
  "permissions": ["scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["global-content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "whatthedog.png",
    "32": "whatthedog.png",
    "48": "whatthedog.png",
    "128": "whatthedog.png"
  }
}
